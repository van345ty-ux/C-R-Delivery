  "06_funcoes": [
    {
      "owner": "postgres",
      "proname": "increment_coupon_usage",
      "arguments": "p_coupon_id uuid",
      "definition": "CREATE OR REPLACE FUNCTION public.increment_coupon_usage(p_coupon_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n  UPDATE coupons \n  SET usage_count = usage_count + 1 \n  WHERE id = p_coupon_id;\nEND;\n$function$\n",
      "privileges": [
        "=X/postgres",
        "postgres=X/postgres",
        "anon=X/postgres",
        "authenticated=X/postgres",
        "service_role=X/postgres"
      ],
      "anon_can_execute": true,
      "authenticated_can_execute": true
    }
  ],
